# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API Keys). Uses Supabase's current publishable
# / secret key naming (drop-in replacements for the legacy anon / service_role
# keys — see https://supabase.com/docs/guides/getting-started/api-keys).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret — server-only. Bypasses Row Level Security. Never import this into
# client components or anything that runs in the browser; it's only used by
# scripts/generate-tags.ts (the /admin dashboard uses the regular RLS-scoped
# client instead — see supabase/migrations/0005_admin_rls.sql).
SUPABASE_SECRET_KEY=sb_secret_your-key

# Base URL used to build the /t/{tag_id} links printed by the provisioning
# script/admin UI. Use your production domain when generating a real batch
# of cards.
SITE_URL=http://localhost:3000

# Admin access to /admin is granted via the private.admin_users table, not
# an env var — see supabase/migrations/0005_admin_rls.sql. To make a user an
# admin: insert into private.admin_users (user_id) select id from auth.users
# where email = '...';

# Powers the "Connect YouTube" button on the profile editor (src/app/api/
# connect/youtube). Create an OAuth 2.0 Client ID (type "Web application")
# in Google Cloud Console, enable the YouTube Data API v3, and add
# {SITE_URL}/api/connect/youtube/callback as an authorized redirect URI
# (add both the localhost and production SITE_URL). Leave unset to hide the
# button's effect — the route redirects back with a "not configured" error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Resend) — src/lib/email/send.ts ------------------------------
# Sends login codes and new-order alerts. BOTH must be set or nothing is
# emailed: on Vercel a missing one is logged as "[email] ... NOT sent"; in
# local dev the message is printed to the terminal instead.
#   API key: https://resend.com/api-keys
#   Sender:  until you verify a domain, use exactly
#            Konek+ <onboarding@resend.dev>
#            — Resend then delivers ONLY to the email you signed up to
#            Resend with. Real customers won't receive anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Konek+ <onboarding@resend.dev>

# Where new-order alerts go (src/app/_landing/order-actions.ts). Leave
# empty to skip. With the test sender above it must be your Resend
# sign-up email.
ORDER_ALERT_EMAIL=

# Where customers send GCash payments — shown on /track (with Copy) once
# their order is confirmed, next to the "Send payment proof" form. Leave
# empty and the page says "We'll message you our GCash number" instead.
GCASH_ACCOUNT_NAME=
GCASH_ACCOUNT_NUMBER=

# New-device login codes (src/app/verify-device, src/proxy.ts,
# supabase/migrations/0009_device_verification.sql). "on" to require a
# code when someone signs in on a new device; anything else = off.
# Keep it OFF until a domain is verified — otherwise customers on a new
# device are sent a code that never arrives and can't sign in.
DEVICE_VERIFICATION=off

# ---- The day you get a domain ---------------------------------------------
# 1. Resend → Domains → add it, then add the SPF/DKIM (and DMARC) DNS records
#    it shows at your domain registrar. Wait for "Verified".
# 2. RESEND_FROM_EMAIL=Konek+ <no-reply@yourdomain.com>
# 3. Supabase → Authentication → SMTP Settings → enable custom SMTP:
#    host smtp.resend.com, port 465, user "resend", password = RESEND_API_KEY,
#    sender = the same no-reply address. (Password resets + signup emails.)
# 4. DEVICE_VERIFICATION=on
# 5. Redeploy on Vercel so the new values take effect.
#
# Also (one-time): Supabase → Authentication → URL Configuration → add
# {SITE_URL}/auth/confirm for both localhost and production, and paste the
# templates from supabase/email-templates/ into Email Templates.

# Daily activation-reminder emails (src/app/api/cron/activation-reminders,
# scheduled in vercel.json). Set a long random string; Vercel Cron sends it as
# a bearer token. The route also needs SUPABASE_SECRET_KEY (service role) set
# on Vercel. Without CRON_SECRET the route refuses every request.
CRON_SECRET=
