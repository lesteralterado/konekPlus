# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API Keys). Uses Supabase's current publishable
# / secret key naming (drop-in replacements for the legacy anon / service_role
# keys — see https://supabase.com/docs/guides/getting-started/api-keys).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret — server-only. Bypasses Row Level Security. Never import this into
# client components or anything that runs in the browser; it's only used by
# scripts/generate-tags.ts (the /admin dashboard uses the regular RLS-scoped
# client instead — see supabase/migrations/0005_admin_rls.sql).
SUPABASE_SECRET_KEY=sb_secret_your-key

# Base URL used to build the /t/{tag_id} links printed by the provisioning
# script/admin UI. Use your production domain when generating a real batch
# of cards.
SITE_URL=http://localhost:3000

# Admin access to /admin is granted via the private.admin_users table, not
# an env var — see supabase/migrations/0005_admin_rls.sql. To make a user an
# admin: insert into private.admin_users (user_id) select id from auth.users
# where email = '...';
